return;     const newName = document.getElementById('mypage-displayname').value.trim();     const newBio = document.getElementById('mypage-bio').value.trim();     if (!newName) return alert('表示名を入力してください。');     dbState.accounts[currentUser.userId] = Object.assign({}, currentUser, {       displayName: newName,       bio: newBio,       avatar: pendingAvatarData || currentUser.avatar,       updatedAt: Date.now()     });     closeModal('mypage-modal');     await commitAndSync();     showToast('プロフィールを更新しました');   }    function viewUserProfile(userId) {     const acc = dbState.accounts[userId];     if (!acc) return;     document.getElementById('view-profile-avatar').src = acc.avatar || DEFAULT_AVATAR;     document.getElementById('view-profile-name').textContent = '★' + acc.displayName;     document.getElementById('view-profile-id').textContent = '@' + acc.userId;     const d = new Date(acc.createdAt);     document.getElementById('view-profile-joined').textContent = `登録日: ${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;     document.getElementById('view-profile-bio').textContent = acc.bio || '（自己紹介はまだ設定されていません）';     document.getElementById('profile-view-modal').style.display = 'flex';   }    (async function boot() {     await loadLocalDb();     renderBoards();     syncUI();     initPeerMesh(0);   })(); </script> </body> </html>
