play:flex; gap:12px; align-items:center; margin-bottom:10px;">       <img id="view-profile-avatar" class="profile-avatar-lg" src="" alt="アイコン">       <div>         <div style="font-size:16px; font-weight:bold; color:#B80000;" id="view-profile-name"></div>         <div style="font-size:13px; color:#555;" id="view-profile-id"></div>         <div style="font-size:12px; color:#666;" id="view-profile-joined"></div>       </div>     </div>     <div style="background:#FFF; border:1px solid #AAA; padding:8px; font-size:14px; white-space:pre-wrap; min-height:50px;" id="view-profile-bio"></div>   </div> </div>  <div id="toast"></div>  <script>   const ROOM_PREFIX = "suremin_p2p_mesh_9x7k2m4p_";   const MAX_SLOTS = 24;   const IDB_NAME = "suremin_p2p_idb_v1";   const IDB_STORE = "kv_store";   const IDB_KEY = "db_state";   const BC_CHANNEL = "suremin_p2p_bc_v1";   const SESSION_USER_KEY = "suremin_p2p_uid_v1";   const READ_STATE_KEY = "suremin_p2p_read_v1";    const BOARDS = [     { id: 'all', name: '総合（全板）' },     { id: 'vip', name: 'ニュー速VIP' },     { id: 'news', name: 'ニュース速報+' },     { id: 'chat', name: 'なんでも雑談' },     { id: 'prog', name: 'プログラマー板' }   ];    const DEFAULT_AVATAR = 'data:image/svg+xml;utf8,' + encodeURIComponent(     '<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">' +     '<rect width="64" height="64" fill="#DCE8DC"/>' +     '<circle cx="32" cy="24" r="12" fill="#5B8A5B"/>' +     '<path d="M12 58 C12 42, 52 42, 52 58" fill="#5B8A5B"/>' +     '</svg>'   );    let myPeer = null;   let mySlotId = null;   const activeConns = new Map();   const bc = ('BroadcastChannel' in window) ? new BroadcastChannel(BC_CHANNEL) : null;    let currentBoard = 'all';   let dbState = {     threads: {},     posts: {},     accounts: {},     enquete_votes: {},     admin_config: { notice: '', ngWords: '', maxFileMB: 5.0, allowedExts: '', updatedAt: 0 }   };    let adminConfig = {     notice: '',     ngWords: [],     maxFileMB: 5.0,     allowedExts: []   };    let currentUser = null;   let authMode = 'login';   let pendingAvatarData = null;    function openIdb() {     return new Promise((resolve, reject) => {       const req = indexedDB.open(IDB_NAME, 1);       req.onupgradeneeded = () => {         const db = req.result;         if (!db.objectStoreNames.contains(IDB_STORE)) {           db.createObjectStore(IDB_STORE);         }       };       req.onsuccess = () => resolve(req.result);       req.onerror = () => reject(req.error);     });   }    async function loadLocalDb() {     try {       const db = await openIdb();       const raw = await new Promise((resolve, reject) => {         const tx = db.transaction(IDB_STORE, 'readonly');         const req = tx.objectStore(IDB_STORE).get(IDB_KEY);         req.onsuccess = () => resolve(req.result);         req.onerror = () => reject(req.error);       });       if (raw && typeof raw === 'object') {         dbState = {           threads: raw.threads || {},           posts: raw.posts || {},           accounts: raw.accounts || {},           enquete_votes: raw.enquete_votes || {},           admin_config: Object.assign({ notice: '', ngWords: '', maxFileMB: 5.0, allowedExts: '', updatedAt: 0 }, raw.admin_config || {})         };       }     } catch (e) {}   }    async function saveLocalDb() {     try {       const db = await openIdb();       await new Promise((resolve, reject) => {         const tx = db.transaction(IDB_STORE, 'readwrite');         tx.objectStore(IDB_STORE).put(dbState, IDB_KEY);         tx.oncomplete = () => resolve();         tx.onerror = () => reject(tx.error);       });     } catch (e) {       alert('保存エラー: ' + e.message);     }   }    if (bc) {     bc.onmessage = async (e) => {       if (e.data === 'DB_UPDATED') {         await loadLocalDb();         syncUI();         broadcastFullState();       }     };   }    function mergeRemoteState(remote) {     if (!remote || typeof remote !== 'object') return false;     let changed = false;      Object.keys(remote.threads || {}).forEach(tid => {       const rTh = remote.threads[tid];       const lTh = dbState.threads[tid];       if (!lTh || (rTh.updatedAt || rTh.createdAt || 0) > (lTh.updatedAt || lTh.createdAt || 0)) {         dbState.threads[tid] = rTh;         changed = true;       }     });      Object.keys(remote.posts || {}).forEach(tid => {       if (!dbState.posts[tid]) dbState.posts[tid] = {};       const rMap = remote.posts[tid] || {};       Object.keys(rMap).forEach(pid => {         const rPost = rMap[pid];         const lPost = dbState.posts[tid][pid];         if (!lPost || (rPost.deleted !== lPost.deleted && (rPost.updatedAt || 0) >= (lPost.updatedAt || 0)) || (rPost.updatedAt || 0) > (lPost.updatedAt || 0)) {           dbState.posts[tid][pid] = rPost;           changed = true;         }       });     });      Object.keys(remote.accounts || {}).forEach(uid => {       const rAcc = remote.accounts[uid];       const lAcc = dbState.accounts[uid];       if (!lAcc || (rAcc.updatedAt || rAcc.createdAt || 0) > (lAcc.updatedAt || lAcc.createdAt || 0)) {         dbState.accounts[uid] = rAcc;         changed = true;       }     });      Object.keys(remote.enquete_votes || {}).forEach(pid => {       if (!dbState.enquete_votes[pid]) dbState.enquete_votes[pid] = {};       const rVotes = remote.enquete_votes[pid] || {};       Object.keys(rVotes).forEach(voter => {         if (dbState.enquete_votes[pid][voter] !== rVotes[voter]) {           dbState.enquete_votes[pid][voter] = rVotes[voter];           changed = true;         }       });     });      if (remote.admin_config && (remote.admin_config.updatedAt || 0) > (dbState.admin_config.updatedAt || 0)) {       dbState.admin_config = Object.assign({}, dbState.admin_config, remote.admin_config);       changed = true;     }      return changed;   }    function updatePeerBadge() {     const badge = document.getElementById('sync-status');     const count = activeConns.size;     if (!myPeer || myPeer.destroyed) {       badge.textContent = '🔴 P2P切断';       badge.style.color = '#CC0000';     } else if (count > 0) {       badge.textContent = `🟢 P2P接続中（${count}台）`;       badge.style.color = '#006600';     } else {       badge.textContent = '🟢 P2P待機中';       badge.style.color = '#006600';     }   }    function setupConnection(conn) {     if (!conn || conn.peer === mySlotId) return;     conn.on('open', () => {       activeConns.set(conn.peer, conn);       updatePeerBadge();       conn.send({ type: 'SYNC_STATE', state: dbState });     });     conn.on('data', async (msg) => {       if (msg && msg.type === 'SYNC_STATE' && msg.state) {         if (mergeRemoteState(msg.state)) {           await saveLocalDb();           if (bc) bc.postMessage('DB_UPDATED');           syncUI();         }       }     });     conn.on('close', () => {       activeConns.delete(conn.peer);       updatePeerBadge();     });     conn.on('error', () => {       activeConns.delete(conn.peer);       updatePeerBadge();     });   }    function broadcastFullState() {     activeConns.forEach(conn => {       if (conn.open) {         try { conn.send({ type: 'SYNC_STATE', state: dbState }); } catch (e) {}       }     });   }    function discoverPeers() {     if (!myPeer || myPeer.destroyed || !myPeer.open) return;     for (let i = 0; i < MAX_SLOTS; i++) {       const targetId = ROOM_PREFIX + i;       if (targetId === mySlotId || activeConns.has(targetId)) continue;       try {         const conn = myPeer.connect(targetId, { reliable: true });         setupConnection(conn);       } catch (e) {}     }   }    function initPeerMesh(slotIndex = 0) {     if (typeof Peer === 'undefined') {       document.getElementById('sync-status').textContent = '🟡 PeerJS読込失敗';       return;     }     if (slotIndex >= MAX_SLOTS) {       mySlotId = ROOM_PREFIX + 'guest_' + Math.random().toString(36).slice(2, 7);     } else {       mySlotId = ROOM_PREFIX + slotIndex;     }      const peer = new Peer(mySlotId);     peer.on('open', () => {       myPeer = peer;       updatePeerBadge();       discoverPeers();     });     peer.on('connection', (conn) => {       setupConnection(conn);     });     peer.on('error', (err) => {       if (err.type === 'unavailable-id' && slotIndex < MAX_SLOTS) {         peer.destroy();         initPeerMesh(slotIndex + 1);       } else {         updatePeerBadge();       }     });   }    async function reconnectMesh(manual = false) {     await loadLocalDb();     discoverPeers();     broadcastFullState();     updatePeerBadge();     syncUI();     if (manual) showToast(`再同期しました（接続中: ${activeConns.size}台）`);   }    setInterval(discoverPeers, 15000);    let initialReadCounts = {};   try {     initialReadCounts = JSON.parse(localStorage.getItem(READ_STATE_KEY) || '{}');   } catch (e) {     initialReadCounts = {};   }    function updateReadCountForThread(threadId, count) {     const cur = JSON.parse(localStorage.getItem(READ_STATE_KEY) || '{}');     if ((cur[threadId] || 0) < count) {       cur[threadId] = count;       localStorage.setItem(READ_STATE_KEY, JSON.stringify(cur));     }   }    function markAllRead() {     const cur = {};     Object.keys(dbState.threads).forEach(tid => {       cur[tid] = getSortedPostsForThread(tid).length;     });     initialReadCounts = cur;     localStorage.setItem(READ_STATE_KEY, JSON.stringify(cur));     renderThreads();     showToast('すべてのスレッドを既読にしました');   }    function getVoterKey() {     if (currentUser) return 'u_' + currentUser.userId;     let seed = localStorage.getItem('suremin_client_seed');     if (!seed) {       seed = Math.random().toString(36).substring(2, 10);       localStorage.setItem('suremin_client_seed', seed);     }     return 'g_' + seed;   }    function updateAttachPolicyHint() {     const hint = document.getElementById('attach-policy-hint');     if (!hint) return;     const extText = adminConfig.allowedExts.length       ? `許可拡張子: ${adminConfig.allowedExts.join(', ')}`       : '全拡張子OK';     hint.textContent = `(上限: ${adminConfig.maxFileMB}MB / ${extText})`;   }    function syncUI() {     const cfg = dbState.admin_config || {};     adminConfig.notice = cfg.notice || '';     adminConfig.ngWords = String(cfg.ngWords || '').split(',').map(s => s.trim()).filter(Boolean);     const mb = parseFloat(cfg.maxFileMB);     adminConfig.maxFileMB = (!isNaN(mb) && mb > 0) ? mb : 5.0;     adminConfig.allowedExts = String(cfg.allowedExts || '')       .split(',')       .map(s => s.trim().toLowerCase().replace(/^\./, ''))       .filter(Boolean);      updateAttachPolicyHint();      const banner = document.getElementById('admin-notice-banner');     if (adminConfig.notice) {       banner.textContent = adminConfig.notice;       banner.style.display = 'block';     } else {       banner.style.display = 'none';     }      const savedUid = localStorage.getItem(SESSION_USER_KEY);     if (savedUid && dbState.accounts[savedUid]) {       currentUser = dbState.accounts[savedUid];       if (currentUser.banned) {         alert('このアカウントは管理人により凍結（BAN）されました。');         logoutAccount();       }     } else if (savedUid && !dbState.accounts[savedUid]) {       currentUser = null;       localStorage.removeItem(SESSION_USER_KEY);     }      renderAccountBar();     renderThreads();   }    async function commitAndSync() {     await saveLocalDb();     if (bc) bc.postMessage('DB_UPDATED');     syncUI();     broadcastFullState();   }    function containsNgWord(text) {     if (!text || !adminConfig.ngWords.length) return false;     const lower = text.toLowerCase();     return adminConfig.ngWords.some(w => lower.includes(w.toLowerCase()));   }    function showToast(msg) {     const t = document.getElementById('toast');     t.textContent = msg;     t.style.display = 'block';     clearTimeout(t._timer);     t._timer = setTimeout(() => { t.style.display = 'none'; }, 2400);   }    function simpleHash(str) {     let h = 0x811c9dc5;     for (let i = 0; i < str.length; i++) {       h ^= str.charCodeAt(i);       h = Math.imul(h, 0x01000193);     }     return ('00000000' + (h >>> 0).toString(16)).slice(-8);   }    function parseNameAndTrip(rawName) {     const trimmed = (rawName || '').trim();     if (!trimmed) return { name: '名無しのスレ民', trip: '' };     const idx = trimmed.indexOf('#');     if (idx === -1) return { name: trimmed, trip: '' };     const baseName = trimmed.slice(0, idx) || '名無しのスレ民';     const key = trimmed.slice(idx + 1);     if (!key) return { name: baseName, trip: '' };     const tripCode = simpleHash('suremin_trip_' + key) + simpleHash(key).slice(0, 2);     return { name: baseName, trip: '◆' + tripCode };   }    function generateDailyId() {     const now = new Date();     const datePart = `${now.getFullYear()}${now.getMonth() + 1}${now.getDate()}`;     let clientSeed = localStorage.getItem('suremin_client_seed');     if (!clientSeed) {       clientSeed = Math.random().toString(36).substring(2, 10);       localStorage.setItem('suremin_client_seed', clientSeed);     }     const raw = simpleHash(datePart + '_' + clientSeed) + simpleHash(clientSeed + '_' + datePart);     const chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/';     let id = '';     for (let i = 0; i < 9; i++) {       const code = parseInt(raw.substr(i % 12, 2), 16) || (i * 7);       id += chars[code % chars.length];     }     return id;   }    function formatDate(ts) {     const d = new Date(ts);     const days = ['日', '月', '火', '水', '木', '金', '土'];     const pad = (n) => String(n).padStart(2, '0');     return `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())}(${days[d.getDay()]}) ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${String(d.getMilliseconds()).padStart(3, '0').slice(0, 2)}`;   }    function formatBytes(bytes) {     if (!bytes) return '';     if (bytes < 1024) return bytes + ' B';     if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';     return (bytes / (1024 * 1024)).toFixed(2) + ' MB';   }    function expandDiceCommands(text) {     return text.replace(/(^|\s)\/(\d{1,2})d(\d{1,6})\b/gi, (match, prefix, countStr, sidesStr) => {       const count = Math.min(20, Math.max(1, parseInt(countStr, 10)));       const sides = Math.min(1000000, Math.max(2, parseInt(sidesStr, 10)));       const rolls = [];       let sum = 0;       for (let i = 0; i < count; i++) {         const r = Math.floor(Math.random() * sides) + 1;         rolls.push(r);         sum += r;       }       const detail = count > 1 ? ` (${rolls.join('+')})` : '';       return `${prefix}【🎲/${count}d${sides} → ${sum}${detail}】`;     });   }    function validateFilePolicy(file) {     const maxBytes = adminConfig.maxFileMB * 1024 * 1024;     if (file.size > maxBytes) {       return `ファイルサイズ上限（${adminConfig.maxFileMB}MB）を超えています（選択中: ${formatBytes(file.size)}）`;     }     if (adminConfig.allowedExts.length > 0) {       const ext = (file.name.split('.').pop() || '').toLowerCase();       if (!adminConfig.allowedExts.includes(ext)) {         return `この拡張子（.${ext}）は現在許可されていません。\n許可拡張子: ${adminConfig.allowedExts.join(', ')}`;       }     }     return null;   }    function compressImageFile(file, maxSize = 400, quality = 0.68) {     return new Promise((resolve, reject) => {       if (!file) return resolve(null);       const reader = new FileReader();       reader.onload = (e) => {         const img = new Image();         img.onload = () => {           let w = img.width;           let h = img.height;           if (w > maxSize || h > maxSize) {             if (w > h) { h = Math.round((h * maxSize) / w); w = maxSize; }             else { w = Math.round((w * maxSize) / h); h = maxSize; }           }           const canvas = document.createElement('canvas');           canvas.width = w;           canvas.height = h;           canvas.getContext('2d').drawImage(img, 0, 0, w, h);           resolve(canvas.toDataURL('image/jpeg', quality));         };         img.onerror = reject;         img.src = e.target.result;       };       reader.onerror = reject;       reader.readAsDataURL(file);     });   }    function readFileAsDataURL(file) {     return new Promise((resolve, reject) => {       const reader = new FileReader();       reader.onload = (e) => resolve(e.target.result);       reader.onerror = reject;       reader.readAsDataURL(file);     });   }    function isAudioFile(fileName, fileData) {     if (fileData && /^data:audio\//i.test(fileData)) return true;     return /\.(mp3|wav|ogg|m4a|aac|flac)$/i.test(fileName || '');   }    async function processAttachment(file) {     if (!file) return { image: null, fileData: null, fileName: null, fileSize: null };     const errMsg = validateFilePolicy(file);     if (errMsg) throw new Error(errMsg);      if (file.type && file.type.startsWith('image/')) {       const imgData = await compressImageFile(file);       return { image: imgData, fileData: null, fileName: null, fileSize: null };     }     const dataUrl = await readFileAsDataURL(file);     return {       image: null,       fileData: dataUrl,       fileName: file.name,       fileSize: formatBytes(file.size)     };   }    function previewSelectedAttachment(inputEl, imgPreviewId, filePreviewId, clearBtnId) {     const file = inputEl.files && inputEl.files[0];     const imgEl = document.getElementById(imgPreviewId);     const fileEl = document.getElementById(filePreviewId);     const clearBtn = document.getElementById(clearBtnId);      imgEl.style.display = 'none';     fileEl.style.display = 'none';     if (clearBtn) clearBtn.style.display = 'none';      if (!file) return;      const errMsg = validateFilePolicy(file);     if (errMsg) {       alert(errMsg);       inputEl.value = '';       return;     }      if (file.type && file.type.startsWith('image/')) {       const reader = new FileReader();       reader.onload = (e) => {         imgEl.src = e.target.result;         imgEl.style.display = 'inline-block';         if (clearBtn) clearBtn.style.display = 'inline-block';       };       reader.readAsDataURL(file);     } else {       fileEl.textContent = `📎 ${file.name} (${formatBytes(file.size)})`;       fileEl.style.display = 'inline-block';       if (clearBtn) clearBtn.style.display = 'inline-block';     }   }    function clearSelectedAttachment(inputId, imgPreviewId, filePreviewId, clearBtnId) {     document.getElementById(inputId).value = '';     document.getElementById(imgPreviewId).style.display = 'none';     document.getElementById(filePreviewId).style.display = 'none';     if (clearBtnId) document.getElementById(clearBtnId).style.display = 'none';   }    function renderBoards() {     const listEl = document.getElementById('board-list');     listEl.innerHTML = '<strong>【板一覧】</strong>';     BOARDS.forEach(b => {       const a = document.createElement('a');       a.className = 'board-item' + (currentBoard === b.id ? ' active' : '');       a.textContent = b.name;       a.onclick = () => selectBoard(b.id);       listEl.appendChild(a);     });   }    function selectBoard(boardId) {     currentBoard = boardId;     const b = BOARDS.find(x => x.id === boardId);     document.getElementById('current-board-heading').textContent = `【${b ? b.name : '総合'}】スレッド一覧`;     if (boardId !== 'all') document.getElementById('new-thread-board').value = boardId;     renderBoards();     renderThreads();   }    function renderAccountBar() {     const bar = document.getElementById('account-bar');     const newThreadBadge = document.getElementById('new-thread-account-badge');     const newThreadNameInput = document.getElementById('new-thread-name');      if (currentUser) {       const avatarSrc = currentUser.avatar || DEFAULT_AVATAR;       bar.innerHTML = `         <span class="user-pill">           <img src="${avatarSrc}" class="avatar-mini" alt="">           ★${escapeHtml(currentUser.displayName)} (@${escapeHtml(currentUser.userId)})         </span>         <button class="btn-classic" onclick="openMyPage()">マイページ</button>         <button class="btn-classic" onclick="logoutAccount()">ログアウト</button>       `;       if (newThreadBadge) newThreadBadge.textContent = `※アカウント「★${currentUser.displayName}」として投稿されます`;       if (newThreadNameInput) newThreadNameInput.style.display = 'none';     } else {       bar.innerHTML = `         <span style="font-size:12px; color:#555;">現在：匿名モード</span>         <button class="btn-classic btn-primary" onclick="openAuthModal('login')">🔑 ログイン / 新規登録</button>       `;       if (newThreadBadge) newThreadBadge.textContent = '';       if (newThreadNameInput) newThreadNameInput.style.display = 'inline-block';     }   }    function escapeHtml(str) {     return String(str || '')       .replace(/&/g, '&amp;')       .replace(/</g, '&lt;')       .replace(/>/g, '&gt;')       .replace(/"/g, '&quot;')       .replace(/'/g, '&#39;');   }    async function voteEnquete(postId, optIdx) {     const voter = getVoterKey();     if (!dbState.enquete_votes[postId]) dbState.enquete_votes[postId] = {};     dbState.enquete_votes[postId][voter] = optIdx;     await commitAndSync();     showToast('アンケートに投票しました');   }    function formatInlineSegment(segment, threadId) {     let escaped = escapeHtml(segment);     escaped = escaped.replace(/(【🎲\/[^】]+】)/g, '<span class="dice-result">$1</span>');     escaped = escaped.replace(/&gt;&gt;(\d+)/g, (match, num) => {       return `<span class="anchor-link" onmouseenter="showAnchorPopup(event, '${threadId}', ${num})" onmouseleave="hideAnchorPopup()" onclick="showAnchorPopup(event, '${threadId}', ${num})">&gt;&gt;${num}</span>`;     });      let embeds = '';     escaped = escaped.replace(/(https?:\/\/[^\s<]+)/g, (url) => {       const rawUrl = url.replace(/&amp;/g, '&');       const ytMatch = rawUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/);       if (ytMatch) {         embeds += `<iframe class="embed-youtube" src="https://www.youtube.com/embed/${ytMatch[1]}" frameborder="0" allowfullscreen loading="lazy"></iframe>`;       } else if (/\.(jpg|jpeg|png|gif|webp)(\?.*)?$/i.test(rawUrl)) {         embeds += `<img src="${url}" class="res-image" onclick="openLightbox('${url}')" alt="埋め込み画像">`;       }       return `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`;     });      return escaped + embeds;   }    function formatBodyHtml(text, threadId, postId) {     const lines = String(text || '').split('\n');     const htmlLines = lines.map(line => {       let working = line;       const placeholders = [];        working = working.replace(/(^|\s)\/enquete\s+((?:"[^"]+"\s*){2,})/gi, (match, prefix, optsStr) => {         const matches = [...optsStr.matchAll(/"([^"]+)"/g)].map(m => m[1]);         if (matches.length < 2) return match;          const postVotes = dbState.enquete_votes[postId] || {};         const voterValues = Object.values(postVotes);         const totalVotes = voterValues.length;         const myVote = postVotes[getVoterKey()];          const optionsHtml = matches.map((optLabel, idx) => {           const count = voterValues.filter(v => Number(v) === idx).length;           const pct = totalVotes > 0 ? Math.round((count / totalVotes) * 100) : 0;           const isVoted = Number(myVote) === idx;           return `             <div class="enquete-option ${isVoted ? 'voted' : ''}" onclick="voteEnquete('${postId}', ${idx})">               <div class="enquete-option-row">                 <span>${isVoted ? '✓ ' : ''}${escapeHtml(optLabel)}</span>                 <span><strong>${count}票</strong> (${pct}%)</span>               </div>               <div class="enquete-bar-bg">                 <div class="enquete-bar-fill" style="width:${pct}%;"></div>               </div>             </div>           `;         }).join('');          const token = `__CMD_PLACEHOLDER_${placeholders.length}__`;         placeholders.push(`<div class="enquete-box"><div class="enquete-title">📊 簡易アンケート（クリックで投票 / 計${totalVotes}票）</div>${optionsHtml}</div>`);         return prefix + token;       });        working = working.replace(/(^|\s)\/hide\s+(.+)$/i, (match, prefix, hiddenText) => {         const token =